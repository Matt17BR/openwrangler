{
  "schemaVersion": 3,
  "tiers": [
    {
      "id": "api-compatible",
      "label": "API-compatible",
      "meaning": "The extension manifest accepts the host API. This does not prove installation, activation, or product behavior."
    },
    {
      "id": "smoke-tested",
      "label": "Smoke-tested",
      "meaning": "One bounded installed-host journey proves installation, activation, a representative open, source immutability, and cleanup."
    },
    {
      "id": "focused-release-seam",
      "label": "Focused release seam",
      "meaning": "The exact candidate artifact passes a named release-blocking seam without claiming the complete product or platform matrix."
    },
    {
      "id": "fully-qualified",
      "label": "Fully qualified",
      "meaning": "The exact candidate artifact passes every required source, installed, platform, security, and release owner for the claim."
    }
  ],
  "editors": [
    {
      "id": "vscode",
