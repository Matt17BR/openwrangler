{
  "name": "openwrangler",
  "displayName": "Open Wrangler",
  "description": "Open files and notebook variables, then clean and export data in VS Code and Cursor. Pandas and Polars are native. DuckDB and PySpark are experimental; their notebook sessions are viewing-only.",
  "version": "1.2.0",
  "publisher": "Matt17BR",
  "license": "MIT",
  "preview": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Matt17BR/openwrangler.git"
  },
  "homepage": "https://github.com/Matt17BR/openwrangler#readme",
  "bugs": {
    "url": "https://github.com/Matt17BR/openwrangler/issues"
  },
  "keywords": [
    "dataframe",
    "data cleaning",
    "csv",
    "parquet",
    "jupyter",
    "polars",
    "duckdb",
    "pandas",
    "openwrangler",
    "vscode",
    "cursor"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Notebooks"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Open Wrangler executes dataframe operations in the selected Python environment. Trust the workspace before opening data."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Desktop file and Python runtime access require a local or remote workspace file system."
    }
  },
  "main": "./dist/extension/activate.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:test-extension": "node scripts/copy-extension-test-runtime-assets.mjs --guard-output-tree && tsc -p tsconfig.extension-test.json && node scripts/copy-extension-test-runtime-assets.mjs",
    "build:webview": "node scripts/build-webviews.mjs",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint .",
    "lint:python": "node scripts/run-python.mjs -m ruff check python && node scripts/run-python.mjs -m ruff format --check python && node scripts/run-pyright.mjs python",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "docs:check": "node scripts/check-docs.mjs",
    "generate:reference": "node scripts/generate-reference.mjs",
    "reference:check": "node scripts/generate-reference.mjs --check",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/generate-protocol.mjs --check",
    "check:remote-jupyter-lock": "node scripts/remote-jupyter-lock.mjs",
    "lock:remote-jupyter": "node scripts/update-remote-jupyter-lock.mjs --write",
    "lock:remote-jupyter:check": "node scripts/update-remote-jupyter-lock.mjs --check",
    "audit:python": "node scripts/run-python.mjs -m pip_audit && npm run audit:remote-jupyter",
    "audit:remote-jupyter": "node scripts/run-python.mjs -m pip_audit --requirement scripts/remote-jupyter/requirements.txt --disable-pip --require-hashes --progress-spinner off --strict",
    "check": "npm run format:check && npm run lint && npm run lint:python && npm run protocol:check && npm run reference:check && npm run typecheck && npm run docs:check && npm run brand:check && npm run check:remote-jupyter-lock && npm run license:check",
    "watch": "npm-run-all --parallel watch:extension watch:webview",
    "watch:extension": "tsc -w -p tsconfig.extension.json",
    "watch:webview": "npm-run-all --parallel watch:webview:main watch:webview:renderer",
    "watch:webview:main": "vite build --watch --mode production",
    "watch:webview:renderer": "vite build --watch --mode notebook-renderer",
    "test": "node scripts/run-heavy-local-command.mjs test -- npm run test:run",
    "test:run": "npm run test:scripts && npm run test:ts && npm run test:python",
    "test:scripts": "node scripts/run-heavy-local-command.mjs test:scripts -- npm run test:scripts:run",
    "test:scripts:run": "npm run test:scripts:workflow && npm run test:scripts:portable && npm run test:scripts:native",
    "test:scripts:workflow": "node --test scripts/ci-workflow.test.mjs",
    "test:scripts:portable": "node scripts/run-heavy-local-command.mjs test:scripts:portable -- npm run test:scripts:portable:run",
    "test:checkout-lifecycle": "node --test scripts/checkout-lifecycle.test.mjs",
    "test:scripts:portable:run": "node --test --test-concurrency=4 scripts/capture-screenshots-json.test.mjs scripts/check-licenses.test.mjs scripts/checkout-lifecycle.test.mjs scripts/create-canonical-release-artifact.test.mjs scripts/cursor-acquisition.test.mjs scripts/data-wrangler-comparison-report.test.mjs scripts/download-canonical-github-release.test.mjs scripts/editor-acceptance-artifact.test.mjs scripts/editor-acceptance-evidence.test.mjs scripts/editor-acceptance.test.mjs scripts/installed-performance-report.test.mjs scripts/installed-performance-system.test.mjs scripts/jupyter-acceptance-environment.test.mjs scripts/marketplace-identity-profile.test.mjs scripts/marketplace-promotion-workflow.test.mjs scripts/marketplace-release-intake.test.mjs scripts/open-vsx-promotion-workflow.test.mjs scripts/package-current-channel.test.mjs scripts/packaged-editor-orchestration.test.mjs scripts/packaged-python-preflight.test.mjs scripts/prepare-stable-candidate-tag.test.mjs scripts/prepare-xvfb.test.mjs scripts/public-writing.test.mjs scripts/publish-github-stable-release.test.mjs scripts/push-stable-release-tag.test.mjs scripts/registry-release-source.test.mjs scripts/release-readiness.test.mjs scripts/remote-jupyter-acceptance.test.mjs scripts/remote-jupyter-lock.test.mjs scripts/remote-workspace-acceptance.test.mjs scripts/remote-workspace-acquisition.test.mjs scripts/remote-workspace-cleanup.test.mjs scripts/remote-workspace-launch.test.mjs scripts/remote-workspace-phase-loader.test.mjs scripts/remote-workspace-processes.test.mjs scripts/remote-workspace-provenance.test.mjs scripts/remote-workspace-staging.test.mjs scripts/remote-workspace-terminal.test.mjs scripts/run-data-wrangler-comparison.test.mjs scripts/run-heavy-local-command.test.mjs scripts/run-installed-performance.test.mjs scripts/stable-release-workflow.test.mjs scripts/verify-canonical-release-artifact.test.mjs scripts/verify-marketplace-publication.test.mjs scripts/verify-open-vsx-release.test.mjs scripts/verify-registry-release-artifact.test.mjs scripts/vsix-archive.test.mjs && npm run test:scripts:media",
    "test:scripts:media": "node scripts/run-heavy-local-command.mjs test:scripts:media -- npm run test:scripts:media:run",
    "test:scripts:media:run": "node --max-old-space-size=1024 --test --test-concurrency=1 scripts/public-media-surfaces.test.mjs scripts/readme-media.test.mjs",
    "test:scripts:native": "node --test scripts/windows-job-supervisor.native.test.mjs",
    "test:ts": "vitest run",
    "test:python-environment-smoke": "vitest run --config vite.python-environment-smoke.config.ts",
    "test:python": "node scripts/run-python.mjs -m pytest python/tests -q",
    "test:extension-host": "node scripts/run-heavy-local-command.mjs test:extension-host -- npm run test:extension-host:run",
    "test:extension-host:run": "npm run build && npm run build:test-extension && node scripts/run-extension-tests.mjs",
    "test:packaged-editors": "node scripts/run-heavy-local-command.mjs test:packaged-editors -- npm run test:packaged-editors:prepare --",
    "test:packaged-editors:prepare": "npm run build:test-extension && node scripts/run-packaged-editor-tests.mjs",
    "test:packaged-editors:run": "node scripts/run-packaged-editor-tests.mjs",
    "test:remote-workspace": "node scripts/run-heavy-local-command.mjs test:remote-workspace -- npm run test:remote-workspace:run",
    "test:remote-workspace:run": "npm run build:test-extension && node scripts/run-remote-workspace-smoke.mjs",
    "prepare:xvfb": "node scripts/prepare-xvfb.mjs --print-path",
    "test:coverage": "node scripts/run-heavy-local-command.mjs test:coverage -- npm run test:coverage:run",
    "test:coverage:run": "npm run test:coverage:ts && npm run test:coverage:python",
    "test:coverage:ts": "vitest run --coverage",
    "test:coverage:python": "node scripts/run-python.mjs -m pytest python/tests -q --cov=openwrangler_runtime --cov-report=term --cov-report=xml:tmp/coverage/python.xml --cov-fail-under=78",
    "license:check": "node scripts/check-licenses.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs --contact-sheet",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "brand:render-check": "node scripts/generate-brand-assets.mjs --render-check",
    "capture:screenshots": "node scripts/run-heavy-local-command.mjs capture:screenshots -- node scripts/capture-screenshots.mjs",
    "compose:readme-media": "node scripts/run-heavy-local-command.mjs compose:readme-media -- node scripts/compose-readme-media.mjs",
    "verify:readme-media": "node scripts/run-heavy-local-command.mjs verify:readme-media -- node scripts/compose-readme-media.mjs --verify",
    "verify:public-media-surfaces": "node scripts/run-heavy-local-command.mjs verify:public-media-surfaces -- node scripts/verify-public-media-surfaces.mjs",
    "test:visual": "node scripts/run-heavy-local-command.mjs test:visual -- npm run test:visual:run",
    "test:visual:run": "npm run build && node scripts/capture-screenshots.mjs --verify",
    "test:accessibility": "node scripts/run-heavy-local-command.mjs test:accessibility -- node scripts/test-webview-accessibility.mjs",
    "test:webview-acceptance": "node scripts/run-heavy-local-command.mjs test:webview-acceptance -- npm run test:webview-acceptance:run",
    "test:webview-acceptance:run": "npm run brand:render-check && npm run verify:readme-media && npm run test:visual && npm run test:accessibility",
    "benchmark:runtime": "node scripts/run-heavy-local-command.mjs benchmark:runtime -- node scripts/run-python.mjs python/benchmarks/runtime_performance.py --strict --fixture-dir tmp/performance --json-out tmp/performance/report.json",
    "comparison:feasibility:smoke": "node scripts/run-data-wrangler-comparison.mjs",
    "checkout:bootstrap": "node scripts/checkout-lifecycle.mjs bootstrap",
    "checkout:create": "node scripts/checkout-lifecycle.mjs create",
    "checkout:status": "node scripts/checkout-lifecycle.mjs status",
    "checkout:audit": "node scripts/checkout-lifecycle.mjs audit",
    "checkout:quarantine-status": "node scripts/checkout-lifecycle.mjs quarantine-status",
    "checkout:handoff": "node scripts/checkout-lifecycle.mjs handoff",
    "checkout:finish": "node scripts/checkout-lifecycle.mjs finish",
    "checkout:plan-retirement": "node scripts/checkout-lifecycle.mjs plan-retirement",
    "checkout:archive-retirement": "node scripts/checkout-lifecycle.mjs archive-retirement",
    "checkout:abandon": "node scripts/checkout-lifecycle.mjs abandon",
    "benchmark:installed": "node scripts/run-heavy-local-command.mjs benchmark:installed -- node scripts/run-installed-performance.mjs",
    "package": "node scripts/run-heavy-local-command.mjs package -- npm run package:run --",
    "package:run": "npm run clean && npm run build && npm run check && npm test && node scripts/package-current-channel.mjs",
    "package:prepared": "node scripts/package-current-channel.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs"
  },
  "activationEvents": [
    "onCommand:openWrangler.openFile",
    "onCommand:openWrangler.changeImportOptions",
    "onCommand:openWrangler.openPath",
    "onCommand:openWrangler.launchDataViewer",
    "onCommand:openWrangler.openNotebookVariable",
    "onCommand:openWrangler.chooseNotebookPreviewProvider",
    "onCommand:openWrangler.checkJupyterIntegration",
    "onCommand:openWrangler.changeRuntime",
    "onCommand:openWrangler.clearRuntime",
    "onCommand:openWrangler.installRuntimeDependencies",
    "onCommand:openWrangler.revalidateRuntimeDependencies",
    "onCommand:openWrangler.startOperation",
    "onCommand:openWrangler.applyStep",
    "onCommand:openWrangler.discardStep",
    "onCommand:openWrangler.editLatestStep",
    "onCommand:openWrangler.selectStep",
    "onCommand:openWrangler.undoStep",
    "onCommand:openWrangler.openViewSort",
    "onCommand:openWrangler.moveViewSortUp",
    "onCommand:openWrangler.moveViewSortDown",
    "onCommand:openWrangler.removeViewSort",
    "onCommand:openWrangler.copyCode",
    "onCommand:openWrangler.exportCode",
    "onCommand:openWrangler.insertNotebookCode",
    "onCommand:openWrangler.exportData",
    "onCommand:openWrangler.openSourceFile",
    "onCommand:openWrangler.openWalkthrough",
    "onCommand:openWrangler.openSettings",
    "onCommand:openWrangler.reportIssue",
    "onCustomEditor:openWrangler.viewer",
    "onView:openWrangler.operations",
    "onView:openWrangler.summary",
    "onView:openWrangler.filters",
    "onView:openWrangler.cleaningSteps",
    "onView:openWrangler.codePreview",
    "onRenderer:openWrangler.renderer",
    "onNotebook:jupyter-notebook"
  ],
  "contributes": {
    "configurationDefaults": {
      "cursor.general.pinnedTitleActions": [
        "openWrangler.openFile",
        "openWrangler.changeImportOptions",
        "openWrangler.openNotebookVariable"
      ]
    },
    "commands": [
      {
        "command": "openWrangler.openFile",
        "title": "Open in Open Wrangler",
        "icon": {
          "light": "media/action-icon-light.svg",
          "dark": "media/action-icon-dark.svg"
        }
      },
      {
        "command": "openWrangler.openPath",
        "title": "Open Wrangler: Open File Path"
      },
      {
        "command": "openWrangler.changeImportOptions",
        "title": "Open Wrangler: Change Import Options",
        "shortTitle": "Change Import Options",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openWrangler.launchDataViewer",
        "title": "Open Wrangler: Launch Selected Notebook Variable"
      },
      {
        "command": "openWrangler.openNotebookVariable",
        "title": "Open in Open Wrangler",
        "shortTitle": "Open in Open Wrangler",
        "category": "Open Wrangler",
        "icon": {
          "light": "media/action-icon-light.svg",
          "dark": "media/action-icon-dark.svg"
        }
      },
      {
        "command": "openWrangler.checkJupyterIntegration",
        "title": "Open Wrangler: Check Jupyter Integration"
      },
      {
        "command": "openWrangler.chooseNotebookPreviewProvider",
        "title": "Open Wrangler: Choose Notebook Preview Provider"
      },
      {
        "command": "openWrangler.changeRuntime",
        "title": "Open Wrangler: Change Runtime"
      },
      {
        "command": "openWrangler.clearRuntime",
        "title": "Open Wrangler: Clear Runtime Override"
      },
      {
        "command": "openWrangler.installRuntimeDependencies",
        "title": "Open Wrangler: Install Runtime Dependencies"
      },
      {
        "command": "openWrangler.revalidateRuntimeDependencies",
        "title": "Open Wrangler: Revalidate Runtime Dependencies"
      },
      {
        "command": "openWrangler.startOperation",
        "title": "Open Wrangler: Add Cleaning Step"
      },
      {
        "command": "openWrangler.applyStep",
        "title": "Open Wrangler: Apply Draft Step",
        "icon": "$(check)"
      },
      {
        "command": "openWrangler.discardStep",
        "title": "Open Wrangler: Discard Draft Step",
        "icon": "$(close)"
      },
      {
        "command": "openWrangler.editLatestStep",
        "title": "Open Wrangler: Edit Latest Step",
        "icon": "$(edit)"
      },
      {
        "command": "openWrangler.selectStep",
        "title": "Open Wrangler: Inspect Applied Step",
        "icon": "$(diff)"
      },
      {
        "command": "openWrangler.undoStep",
        "title": "Open Wrangler: Undo Latest Step",
        "icon": "$(discard)"
      },
      {
        "command": "openWrangler.openViewSort",
        "title": "Open Wrangler: Edit View Sorts",
        "icon": "$(list-ordered)"
      },
      {
        "command": "openWrangler.moveViewSortUp",
        "title": "Open Wrangler: Move View Sort Up",
        "icon": "$(chevron-up)"
      },
      {
        "command": "openWrangler.moveViewSortDown",
        "title": "Open Wrangler: Move View Sort Down",
        "icon": "$(chevron-down)"
      },
      {
        "command": "openWrangler.removeViewSort",
        "title": "Open Wrangler: Remove View Sort",
        "icon": "$(close)"
      },
      {
        "command": "openWrangler.copyCode",
        "title": "Open Wrangler: Copy Generated Code",
        "icon": "$(copy)"
      },
      {
        "command": "openWrangler.exportCode",
        "title": "Open Wrangler: Export Python Script",
        "icon": "$(save-as)"
      },
      {
        "command": "openWrangler.insertNotebookCode",
        "title": "Open Wrangler: Insert Function into Originating Notebook",
        "icon": "$(notebook)"
      },
      {
        "command": "openWrangler.exportData",
        "title": "Open Wrangler: Export Cleaned Data",
        "icon": "$(export)"
      },
      {
        "command": "openWrangler.openSourceFile",
        "title": "Open Wrangler: Open Source File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "openWrangler.openWalkthrough",
        "title": "Open Wrangler: Open Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "openWrangler.openSettings",
        "title": "Open Wrangler: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openWrangler.reportIssue",
        "title": "Open Wrangler: Report Issue",
        "icon": "$(github)"
      }
    ],
    "keybindings": [
      {
        "command": "openWrangler.applyStep",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "activeCustomEditorId == openWrangler.viewer && openWrangler.hasDraft"
      },
      {
        "command": "openWrangler.discardStep",
        "key": "escape",
        "when": "activeCustomEditorId == openWrangler.viewer && openWrangler.hasDraft"
      },
      {
        "command": "openWrangler.editLatestStep",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "activeCustomEditorId == openWrangler.viewer && openWrangler.canChangePlan"
      },
      {
        "command": "openWrangler.undoStep",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "activeCustomEditorId == openWrangler.viewer && openWrangler.canChangePlan"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openWrangler",
          "title": "Open Wrangler",
          "icon": "media/activity-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "openWranglerCode",
          "title": "Open Wrangler Code",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "openWrangler": [
        {
          "id": "openWrangler.operations",
          "name": "Operations"
        },
        {
          "id": "openWrangler.summary",
          "name": "Summary"
        },
        {
          "id": "openWrangler.filters",
          "name": "Filters / Sorts"
        },
        {
          "id": "openWrangler.cleaningSteps",
          "name": "Cleaning Steps"
        }
      ],
      "openWranglerCode": [
        {
          "type": "webview",
          "id": "openWrangler.codePreview",
          "name": "Code Preview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openWrangler.operations",
        "contents": "Open a data file or notebook dataframe to start exploring.\n[Open a data file](command:openWrangler.openPath)"
      }
    ],
    "jupyterVariableViewers": [
      {
        "command": "openWrangler.launchDataViewer",
        "title": "Open in Open Wrangler",
        "dataTypes": [
          "DataFrame",
          "Series",
          "pandas.core.frame.DataFrame",
          "pandas.DataFrame",
          "pandas.core.series.Series",
          "pandas.Series",
          "polars.dataframe.frame.DataFrame",
          "polars.series.series.Series",
          "DuckDBPyRelation",
          "_duckdb.DuckDBPyRelation",
          "duckdb.duckdb.DuckDBPyRelation",
          "pyspark.sql.dataframe.DataFrame",
          "pyspark.sql.classic.dataframe.DataFrame",
          "pyspark.sql.connect.dataframe.DataFrame"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "openWrangler.viewer",
        "displayName": "Open Wrangler",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          }
        ],
        "priority": "option"
      }
    ],
    "notebookRenderer": [
      {
        "id": "openWrangler.renderer",
        "displayName": "Open Wrangler Renderer",
        "entrypoint": "./media/notebookRenderer.js",
        "requiresMessaging": "optional",
        "mimeTypes": [
          "application/vnd.openwrangler.viewer.v2+json"
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Open Wrangler",
        "description": "Open files or notebook variables, inspect profiles, preview cleaning steps, and export code or data. Filters and cleaning steps do not overwrite the source. DuckDB and PySpark are experimental; their notebook sessions are viewing-only.",
        "steps": [
          {
            "id": "openData",
            "title": "Open files or notebook variables",
            "description": "Choose [Open File Path](command:openWrangler.openPath) for CSV, TSV, Parquet, JSONL/NDJSON, or Excel. In a notebook, choose a supported live Pandas, Polars, DuckDB, or PySpark variable from the toolbar."
          },
          {
            "id": "explore",
            "title": "Inspect and filter data",
            "description": "Column profiles, filters, sorts, search, and the virtual grid share one workbench. Filters and sorts remain separate from cleaning steps."
          },
          {
            "id": "clean",
            "title": "Preview a cleaning step",
            "description": "Choose [Add Cleaning Step](command:openWrangler.startOperation), review the changed cells and generated code, then apply or discard the draft."
          },
          {
            "id": "export",
            "title": "Save code or data",
            "description": "Copy generated code, save it as a Python script, insert it into the originating notebook, or export cleaned data to a new CSV or Parquet file."
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "openWrangler.openFile",
          "when": "!explorerResourceIsFolder && resourceScheme =~ /^(file|vscode-remote)$/ && resourceExtname =~ /\\.(csv|tsv|parquet|jsonl|ndjson|xlsx|xls)$/i",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "openWrangler.openFile",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && resourceExtname =~ /\\.(csv|tsv|parquet|jsonl|ndjson|xlsx|xls)$/i && (!activeCustomEditorId || activeCustomEditorId != openWrangler.viewer)",
          "group": "navigation@1"
        },
        {
          "command": "openWrangler.changeImportOptions",
          "when": "openWrangler.canChangeImportOptions && (activeWebviewPanelId == openWrangler.session || activeCustomEditorId == openWrangler.viewer)",
          "group": "navigation@2"
        },
        {
          "command": "openWrangler.openNotebookVariable",
          "when": "notebookType == 'jupyter-notebook' && isWorkspaceTrusted && (config.notebook.globalToolbar != true || openWrangler.forceNotebookEditorTitleAction)",
          "group": "navigation@50"
        }
      ],
      "editor/title/context": [
        {
          "command": "openWrangler.openFile",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && resourceExtname =~ /\\.(csv|tsv|parquet|jsonl|ndjson|xlsx|xls)$/i && (!activeCustomEditorId || activeCustomEditorId != openWrangler.viewer)",
          "group": "navigation@50"
        },
        {
          "command": "openWrangler.changeImportOptions",
          "when": "openWrangler.canChangeImportOptions && (activeWebviewPanelId == openWrangler.session || activeCustomEditorId == openWrangler.viewer)",
          "group": "navigation@51"
        }
      ],
      "commandPalette": [
        {
          "command": "openWrangler.launchDataViewer",
          "when": "false"
        },
        {
          "command": "openWrangler.moveViewSortUp",
          "when": "false"
        },
        {
          "command": "openWrangler.moveViewSortDown",
          "when": "false"
        },
        {
          "command": "openWrangler.removeViewSort",
          "when": "false"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "openWrangler.openNotebookVariable",
          "when": "notebookType == 'jupyter-notebook' && isWorkspaceTrusted && config.notebook.globalToolbar == true && !openWrangler.forceNotebookEditorTitleAction",
          "group": "navigation@50"
        }
      ],
      "view/title": [
        {
          "command": "openWrangler.copyCode",
          "when": "view == openWrangler.codePreview",
          "group": "navigation@10"
        },
        {
          "command": "openWrangler.exportCode",
          "when": "view == openWrangler.codePreview",
          "group": "navigation@11"
        },
        {
          "command": "openWrangler.insertNotebookCode",
          "when": "view == openWrangler.codePreview",
          "group": "navigation@12"
        },
        {
          "command": "openWrangler.openSourceFile",
          "when": "viewContainer == openWrangler",
          "group": "navigation@80"
        },
        {
          "command": "openWrangler.openWalkthrough",
          "when": "viewContainer == openWrangler",
          "group": "navigation@89"
        },
        {
          "command": "openWrangler.openSettings",
          "when": "viewContainer == openWrangler",
          "group": "navigation@90"
        },
        {
          "command": "openWrangler.reportIssue",
          "when": "viewContainer == openWrangler",
          "group": "navigation@91"
        }
      ],
      "view/item/context": [
        {
          "command": "openWrangler.editLatestStep",
          "when": "view == openWrangler.cleaningSteps && viewItem == openWrangler.latestCleaningStep && openWrangler.canChangePlan",
          "group": "inline@10"
        },
        {
          "command": "openWrangler.moveViewSortUp",
          "when": "view == openWrangler.filters && (viewItem == openWrangler.viewSortMiddle || viewItem == openWrangler.viewSortLast)",
          "group": "inline@10"
        },
        {
          "command": "openWrangler.moveViewSortDown",
          "when": "view == openWrangler.filters && (viewItem == openWrangler.viewSortFirst || viewItem == openWrangler.viewSortMiddle)",
          "group": "inline@11"
        },
        {
          "command": "openWrangler.removeViewSort",
          "when": "view == openWrangler.filters && (viewItem == openWrangler.viewSortOnly || viewItem == openWrangler.viewSortFirst || viewItem == openWrangler.viewSortMiddle || viewItem == openWrangler.viewSortLast)",
          "group": "inline@12"
        }
      ]
    },
    "configuration": {
      "title": "Open Wrangler",
      "properties": {
        "openWrangler.defaultBackend": {
          "type": "string",
          "enum": [
            "auto",
            "polars",
            "duckdb",
            "pandas"
          ],
          "default": "auto",
          "description": "Default backend for file-backed sessions. Auto prefers Polars, then DuckDB, and falls back to Pandas when required."
        },
        "openWrangler.fileStartMode": {
          "type": "string",
          "enum": [
            "editing",
            "viewing"
          ],
          "default": "editing",
          "description": "Initial mode for file-backed sessions. Editing remains non-destructive until an explicit export."
        },
        "openWrangler.notebookStartMode": {
          "type": "string",
          "enum": [
            "viewing",
            "editing"
          ],
          "default": "viewing",
          "description": "Initial mode for notebook dataframe sessions."
        },
        "openWrangler.notebookPreviewProvider": {
          "type": "string",
          "enum": [
            "ask",
            "openWrangler",
            "dataWrangler",
            "disabled"
          ],
          "enumDescriptions": [
            "Ask once when Microsoft Data Wrangler is also installed; otherwise use Open Wrangler.",
            "Use Open Wrangler for supported automatic dataframe notebook previews.",
            "Leave automatic dataframe notebook previews to Microsoft Data Wrangler.",
            "Do not install an automatic dataframe notebook preview formatter."
          ],
          "default": "ask",
          "description": "Chooses which extension owns automatic dataframe output previews when another notebook renderer is installed. Explicit openwrangler_runtime.notebook.show(...) output remains available."
        },
        "openWrangler.enabledFileTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "csv",
              "tsv",
              "parquet",
              "jsonl",
              "xlsx",
              "xls"
            ]
          },
          "uniqueItems": true,
          "default": [
            "csv",
            "tsv",
            "parquet",
            "jsonl",
            "xlsx",
            "xls"
          ],
          "description": "File types accepted by Open Wrangler launch commands and offered by its file picker. The JSONL option includes both .jsonl and .ndjson files. Explicit Reopen Editor With selection remains available."
        },
        "openWrangler.insightsOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Show progressive profiles in visible grid headers when a grid opens. PySpark always starts with header profiles off because each profile runs Spark work."
        },
        "openWrangler.filterMode": {
          "type": "string",
          "enum": [
            "basic",
            "advanced"
          ],
          "default": "basic",
          "description": "Default filter builder. Advanced mode exposes AND/OR condition composition."
        },
        "openWrangler.defaultColumnWidth": {
          "type": "number",
          "default": 190,
          "minimum": 80,
          "maximum": 640,
          "description": "Initial grid column width in CSS pixels."
        },
        "openWrangler.fetchBlockSize": {
          "type": "number",
          "default": 200,
          "minimum": 25,
          "maximum": 2000,
          "description": "Number of rows fetched for each virtual grid block."
        },
        "openWrangler.fetchColumnBlockSize": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "maximum": 256,
          "description": "Number of dataframe columns fetched for each horizontal grid block."
        },
        "openWrangler.panelRevealBehavior": {
          "type": "string",
          "enum": [
            "onDraft",
            "always",
            "never"
          ],
          "default": "onDraft",
          "description": "When to reveal the bottom-panel Code Preview: on the first draft in each session, once when each session opens, or never automatically."
        },
        "openWrangler.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python 3.10-3.14 executable override. When empty, Open Wrangler uses the selected Python extension environment, then a system interpreter."
        },
        "openWrangler.sessionOpenTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Maximum duration for opening a dataframe session, including cold engine and notebook-kernel initialization."
        },
        "openWrangler.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Maximum duration for runtime requests other than session opening before recovery restarts and replays the session."
        }
      }
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
