{
  "name": "openwrangler",
  "displayName": "Open Wrangler",
  "description": "Open source dataframe workbench for VS Code and Cursor: Pandas and Polars editing, experimental DuckDB file editing and relation viewing, local PySpark 4.2 notebook viewing, and preview native R.",
  "version": "1.99.7",
  "publisher": "Matt17BR",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Matt17BR/openwrangler.git"
  },
  "homepage": "https://github.com/Matt17BR/openwrangler#readme",
  "bugs": {
    "url": "https://github.com/Matt17BR/openwrangler/issues"
  },
  "keywords": [
    "dataframe",
    "data cleaning",
    "csv",
    "parquet",
    "jupyter",
    "polars",
    "duckdb",
    "pandas",
    "r",
    "rstats",
    "tibble",
    "data.table",
    "python",
    "pyspark",
    "quarto",
    "rmarkdown",
    "tidyverse",
    "data preview",
    "data wrangling",
    "vscode forks",
    "vscode",
    "cursor"
  ],
  "engines": {
    "node": ">=22.22.0 <23",
    "vscode": "^1.106.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Notebooks"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Open Wrangler executes dataframe operations in Python and R runtimes. Trust the workspace before opening data."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Desktop file and language-runtime access require a local or remote workspace file system."
    }
  },
  "main": "./dist/extension/activate.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node scripts/copy-extension-vendor-assets.mjs --guard-output-tree dist && tsc -p tsconfig.extension.json && node scripts/copy-extension-vendor-assets.mjs dist",
    "build:test-extension": "node scripts/copy-extension-vendor-assets.mjs --guard-output-tree dist-test && node scripts/copy-extension-test-runtime-assets.mjs --guard-output-tree && tsc -p tsconfig.extension-test.json && node scripts/copy-extension-vendor-assets.mjs dist-test && node scripts/copy-extension-test-runtime-assets.mjs",
    "build:webview": "node scripts/build-webviews.mjs",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "typecheck:dependencies": "tsc -p tsconfig.dependencies.json --noEmit",
    "lint": "eslint .",
    "lint:python": "node scripts/run-python.mjs -m ruff check python && node scripts/run-python.mjs -m ruff format --check python && node scripts/run-pyright.mjs python",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "docs:check": "node scripts/check-docs.mjs && node scripts/spec-invariants.mjs --check",
    "repository:check": "node scripts/public-repository-metadata.mjs --local",
    "repository:check-live": "node scripts/public-repository-metadata.mjs --live",
    "generate:reference": "node scripts/generate-reference.mjs",
    "reference:check": "node scripts/generate-reference.mjs --check",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/generate-protocol.mjs --check",
    "check:remote-jupyter-lock": "node scripts/remote-jupyter-lock.mjs",
    "check:r-dependency-lock": "node scripts/r-dependency-lock.mjs check r/dependencies/native-r-contract/ubuntu-24.04-x86_64-r-4.4.lock.json r/dependencies/native-r-contract/ubuntu-24.04-x86_64-r-4.5.lock.json",
    "lock:remote-jupyter": "node scripts/update-remote-jupyter-lock.mjs --write",
    "lock:remote-jupyter:check": "node scripts/update-remote-jupyter-lock.mjs --check",
    "audit:python": "node scripts/run-python.mjs -m pip_audit && npm run audit:remote-jupyter",
    "audit:node": "npm audit --audit-level=high",
    "audit:remote-jupyter": "node scripts/run-python.mjs -m pip_audit --requirement scripts/remote-jupyter/requirements.txt --disable-pip --require-hashes --progress-spinner off --strict && node scripts/run-python.mjs -m pip_audit --requirement scripts/remote-jupyter/requirements.r.txt --disable-pip --require-hashes --progress-spinner off --strict",
    "check:invariants": "npm run format:check && npm run lint && npm run lint:python && npm run protocol:check && npm run reference:check && npm run docs:check && npm run brand:check && npm run check:remote-jupyter-lock && npm run check:r-dependency-lock && npm run license:check",
    "check": "npm run format:check && npm run lint && npm run lint:python && npm run protocol:check && npm run reference:check && npm run typecheck && npm run typecheck:dependencies && npm run docs:check && npm run brand:check && npm run check:remote-jupyter-lock && npm run check:r-dependency-lock && npm run license:check",
    "check:fast-feedback": "npm-run-all --parallel --continue-on-error format:check lint typecheck",
    "check:pr": "npm-run-all --parallel --continue-on-error --max-parallel 2 --print-label check test",
    "watch": "npm-run-all --parallel watch:extension watch:webview",
    "prewatch:extension": "npm run build:extension",
    "watch:extension": "tsc -w -p tsconfig.extension.json",
    "watch:webview": "npm-run-all --parallel watch:webview:main watch:webview:renderer",
    "watch:webview:main": "vite build --watch --mode production",
    "watch:webview:renderer": "vite build --watch --mode notebook-renderer",
    "test": "npm run test:run",
    "test:run": "npm run test:scripts && npm run test:ts && npm run test:python",
    "test:scripts": "npm run test:scripts:run",
    "test:scripts:run": "npm run test:scripts:workflow && npm run test:scripts:portable && npm run test:scripts:native",
    "test:scripts:workflow": "node --test scripts/candidate-acceptance-workflow.test.mjs scripts/ci-workflow.test.mjs",
    "test:scripts:portable": "npm run test:scripts:portable:run && node --test scripts/soak/runtime-soak.test.mjs",
    "test:scripts:portable:run": "node --test --test-concurrency=4 scripts/capture-screenshots-json.test.mjs scripts/check-licenses.test.mjs scripts/copy-extension-vendor-assets.test.mjs scripts/create-canonical-release-artifact.test.mjs scripts/cursor-acquisition.test.mjs scripts/daily-preview-artifact.test.mjs scripts/data-wrangler-comparison-install.test.mjs scripts/data-wrangler-comparison-neutral-driver.test.mjs scripts/data-wrangler-comparison-report.test.mjs scripts/data-wrangler-comparison-study.test.mjs scripts/download-canonical-github-release.test.mjs scripts/editor-acceptance-artifact.test.mjs scripts/editor-acceptance-evidence.test.mjs scripts/editor-acceptance.test.mjs scripts/installed-performance-report.test.mjs scripts/installed-performance-system.test.mjs scripts/jupyter-acceptance-environment.test.mjs scripts/linux-pss-sampler.test.mjs scripts/marketplace-identity-profile.test.mjs scripts/marketplace-promotion-workflow.test.mjs scripts/marketplace-release-intake.test.mjs scripts/open-vsx-promotion-workflow.test.mjs scripts/package-current-channel.test.mjs scripts/package-source-manifest.test.mjs scripts/packaged-editor-orchestration.test.mjs scripts/packaged-python-preflight.test.mjs scripts/prepare-stable-candidate-tag.test.mjs scripts/prepare-xvfb.test.mjs scripts/public-repository-metadata.test.mjs scripts/public-writing.test.mjs scripts/publish-github-stable-release.test.mjs scripts/push-stable-release-tag.test.mjs scripts/r-dependency-lock.test.mjs scripts/r-editor-acceptance-tooling.test.mjs scripts/r-performance-report.test.mjs scripts/registry-release-source.test.mjs scripts/release-candidate.test.mjs scripts/release-readiness.test.mjs scripts/remote-jupyter-acceptance.test.mjs scripts/remote-jupyter-lock.test.mjs scripts/remote-workspace-acceptance.test.mjs scripts/remote-workspace-acquisition.test.mjs scripts/remote-workspace-cleanup.test.mjs scripts/remote-workspace-launch.test.mjs scripts/remote-workspace-phase-loader.test.mjs scripts/remote-workspace-processes.test.mjs scripts/remote-workspace-provenance.test.mjs scripts/remote-workspace-staging.test.mjs scripts/remote-workspace-terminal.test.mjs scripts/reproducible-vsix.test.mjs scripts/run-installed-performance.test.mjs scripts/run-r-contract-tests.test.mjs scripts/run-r-performance.test.mjs scripts/spec-invariants.test.mjs scripts/stable-release-workflow.test.mjs scripts/verify-canonical-release-artifact.test.mjs scripts/verify-marketplace-publication.test.mjs scripts/verify-open-vsx-release.test.mjs scripts/verify-registry-release-artifact.test.mjs scripts/vsix-archive.test.mjs && npm run test:scripts:media",
    "test:scripts:media": "npm run test:scripts:media:run",
    "test:scripts:media:run": "node --max-old-space-size=1024 --test --test-concurrency=1 scripts/public-media-surfaces.test.mjs scripts/readme-media.test.mjs",
    "test:scripts:native": "node --test scripts/windows-job-supervisor.native.test.mjs",
    "test:ts": "vitest run",
    "test:r-contract": "node scripts/run-r-contract-tests.mjs",
    "test:r-contract:frame-and-interactive-transport": "node scripts/run-r-contract-tests.mjs --shard frame-and-interactive-transport",
    "test:r-contract:catalog-and-process-transport": "node scripts/run-r-contract-tests.mjs --shard catalog-and-process-transport",
    "test:r-contract:protocol": "npm-run-all --continue-on-error --print-label test:r-contract:frame-and-interactive-transport test:r-contract:catalog-and-process-transport",
    "test:python-environment-smoke": "vitest run --config vite.python-environment-smoke.config.ts",
    "test:python": "node scripts/run-python.mjs -m pytest python/tests -q",
    "test:extension-host": "npm run test:extension-host:run",
    "test:extension-host:run": "npm run build && npm run build:test-extension && node scripts/run-extension-tests.mjs",
    "test:packaged-editors": "npm run test:packaged-editors:prepare --",
    "test:packaged-editors:prepare": "npm run build:test-extension && node scripts/run-packaged-editor-tests.mjs",
    "test:packaged-editors:run": "node scripts/run-packaged-editor-tests.mjs",
    "test:remote-workspace": "npm run test:remote-workspace:run",
    "test:remote-workspace:run": "npm run build:test-extension && node scripts/run-remote-workspace-smoke.mjs",
    "prepare:xvfb": "node scripts/prepare-xvfb.mjs --print-path",
    "test:coverage": "npm run test:coverage:run",
    "test:coverage:run": "npm run test:coverage:ts && npm run test:coverage:python",
    "test:coverage:ts": "vitest run --coverage",
    "test:coverage:python": "node scripts/run-python.mjs -m pytest python/tests -q --cov=openwrangler_runtime --cov-report=term --cov-report=xml:tmp/coverage/python.xml --cov-fail-under=78",
    "license:check": "node scripts/check-licenses.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs --contact-sheet",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "brand:render-check": "node scripts/generate-brand-assets.mjs --render-check",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "compose:readme-media": "node scripts/compose-readme-media.mjs",
    "verify:readme-media": "node scripts/compose-readme-media.mjs --verify",
    "verify:public-media-surfaces": "node scripts/verify-public-media-surfaces.mjs",
    "test:visual": "npm run test:visual:run",
    "test:visual:run": "npm run build && node scripts/capture-screenshots.mjs --verify",
    "test:accessibility": "node scripts/test-webview-accessibility.mjs",
    "test:webview-acceptance": "npm run test:webview-acceptance:run",
    "test:webview-acceptance:run": "node scripts/packaged-python-preflight.mjs visual && node scripts/webview-browser.mjs && npm run brand:render-check && npm run verify:readme-media && npm run verify:readme-responsive-render && npm run test:visual && npm run test:accessibility",
    "verify:readme-responsive-render": "node scripts/verify-readme-responsive-render.mjs",
    "benchmark:runtime": "node scripts/run-python.mjs python/benchmarks/runtime_performance.py --strict --fixture-dir tmp/performance --json-out tmp/performance/report.json",
    "benchmark:r": "node scripts/run-r-performance.mjs",
    "benchmark:pyspark-profile": "node scripts/run-python.mjs python/benchmarks/pyspark_profile.py",
    "comparison:smoke": "node scripts/data-wrangler-comparison-study.mjs smoke",
    "comparison:study": "node scripts/data-wrangler-comparison-study.mjs run",
    "comparison:local": "node scripts/data-wrangler-comparison-study.mjs local",
    "comparison:report": "node scripts/data-wrangler-comparison-study.mjs report",
    "benchmark:installed": "node scripts/run-installed-performance.mjs",
    "package": "npm run package:run --",
    "package:dev": "npm run clean && npm run build && node scripts/package-current-channel.mjs --out openwrangler-dev.vsix",
    "package:run": "npm run clean && npm run build && npm run check && npm test && node scripts/package-current-channel.mjs",
    "package:prepared": "node scripts/package-current-channel.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs"
  },
  "activationEvents": [
    "onCommand:openWrangler.openFile",
    "onCommand:openWrangler.convertTrustedPickle",
    "onCommand:openWrangler.changeImportOptions",
    "onCommand:openWrangler.openPath",
    "onCommand:openWrangler.launchDataViewer",
    "onCommand:openWrangler.openNotebookVariable",
    "onCommand:openWrangler.openNotebookCellResult",
    "onCommand:openWrangler.runPythonCellAndOpenVariable",
    "onCommand:openWrangler.refreshLiveDataframes",
    "onCommand:openWrangler.refreshNotebookVariables",
    "onCommand:openWrangler.openRDataframe",
    "onCommand:openWrangler.runRDocument",
    "onCommand:openWrangler.openRInteractiveVariable",
    "onCommand:openWrangler.refreshRInteractiveVariables",
    "onCommand:openWrangler.openCachedRInteractiveVariable",
    "onCommand:openWrangler.chooseNotebookPreviewProvider",
    "onCommand:openWrangler.checkJupyterIntegration",
    "onCommand:openWrangler.changeRuntime",
    "onCommand:openWrangler.clearRuntime",
    "onCommand:openWrangler.installRuntimeDependencies",
    "onCommand:openWrangler.revalidateRuntimeDependencies",
    "onCommand:openWrangler.startOperation",
    "onCommand:openWrangler.applyStep",
    "onCommand:openWrangler.discardStep",
    "onCommand:openWrangler.editLatestStep",
    "onCommand:openWrangler.selectStep",
    "onCommand:openWrangler.undoStep",
    "onCommand:openWrangler.openViewSort",
    "onCommand:openWrangler.moveViewSortUp",
    "onCommand:openWrangler.moveViewSortDown",
    "onCommand:openWrangler.removeViewSort",
    "onCommand:openWrangler.copyCode",
    "onCommand:openWrangler.exportCode",
    "onCommand:openWrangler.insertNotebookCode",
    "onCommand:openWrangler.insertRDocumentCode",
    "onCommand:openWrangler.exportData",
    "onCommand:openWrangler.openSourceFile",
    "onCommand:openWrangler.openWalkthrough",
    "onCommand:openWrangler.openSettings",
    "onCommand:openWrangler.reportIssue",
    "onCustomEditor:openWrangler.viewer",
    "onView:openWrangler.operations",
    "onView:openWrangler.summary",
    "onView:openWrangler.filters",
    "onView:openWrangler.cleaningSteps",
    "onView:openWrangler.codePreview",
    "onRenderer:openWrangler.renderer",
    "onNotebook:jupyter-notebook",
    "onNotebook:interactive"
  ],
  "contributes": {
    "configurationDefaults": {
      "cursor.general.pinnedTitleActions": [
        "openWrangler.openFile",
        "openWrangler.changeImportOptions",
        "openWrangler.openNotebookVariable",
        "openWrangler.runPythonCellAndOpenVariable",
        "openWrangler.openRDataframe"
      ]
    },
    "commands": [
      {
        "command": "openWrangler.openFile",
        "title": "Open in Open Wrangler",
        "icon": {
          "light": "media/action-icon-light.svg",
          "dark": "media/action-icon-dark.svg"
        }
      },
      {
        "command": "openWrangler.openPath",
        "title": "Open Wrangler: Open File Path"
      },
      {
        "command": "openWrangler.convertTrustedPickle",
        "title": "Convert Trusted Pickle to Parquet…",
        "category": "Open Wrangler"
      },
      {
        "command": "openWrangler.changeImportOptions",
        "title": "Open Wrangler: Change Import Options",
        "shortTitle": "Change Import Options",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openWrangler.launchDataViewer",
        "title": "Open Wrangler: Launch Selected Notebook Variable"
      },
      {
        "command": "openWrangler.openNotebookVariable",
        "title": "Open in Open Wrangler",
        "shortTitle": "Open in Open Wrangler",
        "category": "Open Wrangler",
        "icon": {
          "light": "media/action-icon-light.svg",
          "dark": "media/action-icon-dark.svg"
        }
      },
      {
        "command": "openWrangler.openNotebookCellResult",
        "title": "Open Executed Dataframe Result in Open Wrangler",
        "category": "Open Wrangler"
      },
      {
        "command": "openWrangler.runPythonCellAndOpenVariable",
        "title": "Open in Open Wrangler",
        "shortTitle": "Open in Open Wrangler",
        "category": "Open Wrangler",
        "icon": {
          "light": "media/action-icon-light.svg",
          "dark": "media/action-icon-dark.svg"
        }
      },
      {
        "command": "openWrangler.refreshLiveDataframes",
        "title": "Open Wrangler: Refresh Live Dataframes",
        "shortTitle": "Refresh Live Dataframes",
        "category": "Open Wrangler",
        "icon": "$(refresh)"
      },
      {
        "command": "openWrangler.refreshNotebookVariables",
        "title": "Open Wrangler: Refresh Notebook Dataframes",
        "shortTitle": "Refresh Notebook Dataframes",
        "category": "Open Wrangler",
        "icon": "$(refresh)"
      },
      {
        "command": "openWrangler.openCachedNotebookVariable",
        "title": "Open Wrangler: Open Live Dataframe"
      },
      {
        "command": "openWrangler.openRDataframe",
        "title": "Open Wrangler: Open R Dataframe",
        "shortTitle": "Open in Open Wrangler",
